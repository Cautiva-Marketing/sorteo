# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local al repositorio.

# --- Configuración web pública de Firebase (visible en el navegador) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Clave de sitio de reCAPTCHA Enterprise usada por Firebase App Check
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Credenciales de servidor (Admin SDK; NUNCA con prefijo NEXT_PUBLIC_) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clave privada de la cuenta de servicio; conserva los saltos de línea como \n
FIREBASE_PRIVATE_KEY=

# App Check: "on" por defecto; "off" solo en desarrollo/pruebas (en producción el servidor no arranca con "off")
APP_CHECK_ENFORCEMENT=

# --- Solo para emuladores locales y E2E; nunca en producción ---
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
