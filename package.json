{
  "name": "registro-sorteo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run tests/unit",
    "test": "firebase emulators:exec --project demo-sorteo --only firestore,auth \"vitest run\"",
    "test:rules": "firebase emulators:exec --project demo-sorteo --only firestore \"vitest run tests/rules\"",
    "test:e2e": "firebase emulators:exec --project demo-sorteo --only firestore,auth \"playwright test\"",
    "emulators": "firebase emulators:start --project demo-sorteo --only firestore,auth",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "perf": "firebase emulators:exec --project demo-sorteo --only firestore \"node scripts/lighthouse.mjs\""
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@tailwindcss/postcss": "4.3.3",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "15.34.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
